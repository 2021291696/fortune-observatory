# destiny API 环境变量模板 —— 复制为 .env 后填真实值；.env 不入 git，只存在于服务器
# 铁律：密钥只在服务器上（deploy.sh 绝不覆盖服务器 .env）

# ---- AI provider（必填三项才启用 AI 层；缺任一则 AI 端点返回 503，排盘不受影响）----
# provider 的 API key（如 MiniMax）
FORTUNE_AI_API_KEY=
# 模型名
FORTUNE_AI_MODEL=
# 事实上下文 HMAC 签名密钥：至少 32 字节随机串（openssl rand -base64 48）
FORTUNE_AI_CONTEXT_SECRET=

# ---- AI provider 可选项 ----
# 默认 https://api.openai.com/v1；换 provider 时必须同时加白 FORTUNE_AI_ALLOWED_HOSTS
# 强制 https（本地 provider 除外）、禁 userinfo/query/fragment、内网字面 IP 拒绝
FORTUNE_AI_BASE_URL=https://api.openai.com/v1
# 主机白名单（逗号分隔，默认 api.openai.com）
FORTUNE_AI_ALLOWED_HOSTS=api.openai.com
# 单次调用超时秒数（1-55，默认 40）
FORTUNE_AI_TIMEOUT_SECONDS=40
# AI 日预算（次/天/进程，1-10000，默认 240）
FORTUNE_AI_DAILY_LIMIT=240
# 输出约束：json_schema | json_object | none（默认 json_schema）
FORTUNE_AI_RESPONSE_FORMAT=json_schema
# 解读流式最大输出 tokens（默认 32000）
FORTUNE_AI_READING_MAX_TOKENS=32000
# 允许本地回环 provider（仅本地调试，生产禁开）
FORTUNE_AI_ALLOW_LOCAL_PROVIDER=false
# 预算口径：仅支持 single_worker（shared_gateway 未实现，配置即报错拒启）
FORTUNE_AI_BUDGET_SCOPE=single_worker

# ---- HTTP 防护 ----
# 浏览器来源白名单（逗号分隔；留空则不加 CORS 中间件，由网关托管；禁 *）
# 本地开发示例：http://localhost:5173,http://127.0.0.1:5173
FORTUNE_CORS_ORIGINS=
# TrustedHost 白名单（逗号分隔；网关部署必须配公网域名，如 destiny.solplum.com）
# 不配则只放行 127.0.0.1,localhost,testserver（fail-closed）
FORTUNE_ALLOWED_HOSTS=destiny.solplum.com
# 是否信任反代注入的客户端 IP 头（nginx 侧为覆盖式 XFF 时才开 true）
FORTUNE_TRUST_PROXY=false
# 客户端 IP 请求头名（默认 x-forwarded-for）
FORTUNE_CLIENT_IP_HEADER=x-forwarded-for
