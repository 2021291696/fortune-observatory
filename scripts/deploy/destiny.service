[Unit]
Description=Fortune Observatory API+SPA (destiny.solplum.com)
After=network.target

[Service]
Type=simple
User=destiny
Group=destiny
WorkingDirectory=/opt/destiny
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/destiny/src:/opt/destiny/apps/api
EnvironmentFile=/opt/destiny/.env
ExecStart=/opt/destiny/.venv/bin/python -m uvicorn serve:serve --host 127.0.0.1 --port 8742 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
